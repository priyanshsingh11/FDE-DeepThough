# ── Universal env template for Cold Call Assistant ──
# Copy to ".env" (project root) and fill in values. Never commit the real file.

# ===== Database (Supabase) =====
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ===== LLM (dev-time transcript analysis only; never used by the deployed app) =====
LLM_PROVIDER=groq
LLM_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile

# ===== Backend CORS (allowed frontend origins, comma-separated) =====
ALLOWED_ORIGINS=http://localhost:3000

# ===== Frontend =====
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
